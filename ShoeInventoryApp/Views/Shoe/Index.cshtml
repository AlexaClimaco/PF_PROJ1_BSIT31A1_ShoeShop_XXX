@model IEnumerable<ShoeInventoryApp.Models.Shoe>

@{
    ViewData["Title"] = "Shoes";
}

<h1>Shoes</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Add New Shoe</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Brand</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var shoe in Model)
        {
            <tr>
                <td>@shoe.Name</td>
                <td>@shoe.Brand</td>
                <td>@shoe.Price.ToString("C")</td>
                <td>
                    <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@shoe.Id">Details</a>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@shoe.Id">Edit</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@shoe.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
